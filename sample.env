# Copy to .env and fill in what you need:   cp sample.env .env
# Nothing is required to run the server locally against data/resumes; the
# sections below enable storage backends, PDF upload and semantic search.

# --- Storage -----------------------------------------------------------------
# Where resume YAML versions and job descriptions live. Plain directories by
# default; *_FS_URL accepts any PyFilesystem2 URL (e.g. s3://bucket/prefix).
# RESUME_DATA_DIR=data/resumes
# RESUME_JD_DIR=data/jd
# RESUME_FS_URL=s3://my-bucket/resumes
# JD_FS_URL=s3://my-bucket/jd
# LOGS_DIR=logs

# S3-compatible credentials used by s3:// filesystems and PDF uploads
# (Cloudflare R2, MinIO, AWS...). AWS_* names are accepted as fallbacks.
# RESUME_S3_ENDPOINT_URL=https://<account>.r2.cloudflarestorage.com
# RESUME_S3_REGION=auto
# RESUME_S3_ACCESS_KEY_ID=
# RESUME_S3_SECRET_ACCESS_KEY=
# RESUME_S3_ADDRESSING_STYLE=path

# --- PDF rendering -------------------------------------------------------------
# LaTeX is compiled by the separately deployed latex-compile service.
# LATEX_COMPILE_API_URL=https://latex-compile.k.0x1f0c.dev

# Rendered PDFs / Overleaf zips are uploaded here and returned as links.
# RESUME_S3_BUCKET_NAME=
# RESUME_S3_KEY_PREFIX=resumes/
# RESUME_S3_PUBLIC_BASE_URL=https://pub-xxxx.r2.dev

# --- Semantic search (search_resume_entries) ----------------------------------
# EMBEDDING_PROVIDER=google            # google | openai
# GOOGLE_API_KEY=
# OPENAI_API_KEY=
# OPENAI_BASE_URL=                     # e.g. https://openrouter.ai/api/v1
# OPENROUTER_API_KEY=                  # used when OPENAI_BASE_URL is OpenRouter
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# VECTOR_DB_DIR=data/vector_db
# VECTOR_INDEX_STATUS_PATH=data/vector_db/index_status.json

# --- Server ------------------------------------------------------------------
# Overrides for the --transport / --port command-line flags.
# MCP_TRANSPORT=stdio                  # stdio | http
# MCP_PORT=8000
# MCP_CORS_ALLOW_ORIGINS=*             # comma-separated, HTTP transport only
